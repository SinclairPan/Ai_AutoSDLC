{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc-v2-directional-blind-evaluator-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "opaque_run_id", "candidate_snapshot_sha256"],
  "properties": {
    "schema": {"const": "ai-sdlc-v2-directional-blind-evaluator-input/v1"},
    "opaque_run_id": {"type": "string", "pattern": "^run-[a-f0-9]{24}$"},
    "candidate_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
