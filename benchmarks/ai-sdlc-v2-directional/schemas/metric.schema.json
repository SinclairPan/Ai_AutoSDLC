{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc-v2-directional-metric/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "external_verified_delivery",
    "weighted_acceptance_coverage",
    "severe_defect_escape_count",
    "wall_time_seconds",
    "provider_sessions",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "currency_cost"
  ],
  "properties": {
    "schema": {"const": "ai-sdlc-v2-directional-metric/v1"},
    "run_id": {"type": "string", "pattern": "^run-[a-f0-9]{24}$"},
    "external_verified_delivery": {"type": "boolean"},
    "weighted_acceptance_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "severe_defect_escape_count": {"type": "integer", "minimum": 0},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "provider_sessions": {"type": "integer", "minimum": 1, "maximum": 3},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "currency_cost": {"type": ["number", "null"], "minimum": 0}
  }
}
