{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc-v2-directional-preflight/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_sha256",
    "execution_order",
    "output_root",
    "provider_calls_started",
    "formal_authority_status",
    "evaluator_classification",
    "model",
    "reasoning_effort",
    "writer_sessions",
    "expert_sessions",
    "hard_session_cap",
    "technical_retries",
    "input_tokens",
    "output_tokens",
    "currency_cost"
  ],
  "properties": {
    "schema": {"const": "ai-sdlc-v2-directional-preflight/v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_order": {"type": "array", "minItems": 19, "maxItems": 19, "uniqueItems": true, "items": {"type": "string", "pattern": "^session-[a-f0-9]{24}$"}},
    "output_root": {"const": "/private/tmp/ai-sdlc-v2-directional-results/20260820-v1"},
    "provider_calls_started": {"const": 0},
    "formal_authority_status": {"const": "NO-GO"},
    "evaluator_classification": {"const": "legacy-directional-evaluator"},
    "model": {"const": "gpt-5.6-sol"},
    "reasoning_effort": {"const": "high"},
    "writer_sessions": {"const": 15},
    "expert_sessions": {"const": 4},
    "hard_session_cap": {"const": 19},
    "technical_retries": {"const": 0},
    "input_tokens": {"type": "null"},
    "output_tokens": {"type": "null"},
    "currency_cost": {"type": "null"}
  }
}
