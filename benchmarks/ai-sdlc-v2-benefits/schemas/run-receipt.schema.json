{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc-v2-benefit-run-receipt/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_sha256", "run_id", "arm", "fixture", "order", "status", "failure_classification", "identity", "digests", "timestamps", "provider_cwd", "provider_attempts", "timings", "token_usage", "measurements", "human_events", "automated_events", "command_evidence", "changed_files", "final_candidate_tree_sha256", "loop", "external_evaluator"],
  "properties": {
    "schema": {"type": "string", "const": "ai-sdlc-v2-benefit-run-receipt/v2"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"type": "string", "enum": ["P", "S", "A00", "A10", "A11"]},
    "fixture": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1, "maximum": 5},
    "status": {"type": "string", "enum": ["completed", "failed", "timeout", "needs_operator", "budget_exhausted"]},
    "failure_classification": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_sdlc_version", "ai_sdlc_commit", "source_tree_sha", "superpowers_commit", "benchmark_commit", "fixture_tree_sha256", "codex_version", "model", "reasoning_effort", "runner_script_sha256", "writer_timeout_seconds", "expert_timeout_seconds", "fixture_commitment"],
      "properties": {
        "ai_sdlc_version": {"type": "string", "minLength": 1},
        "ai_sdlc_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "superpowers_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "benchmark_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "fixture_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "codex_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "runner_script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "writer_timeout_seconds": {"type": "integer", "minimum": 1},
        "expert_timeout_seconds": {"type": "integer", "minimum": 1},
        "fixture_commitment": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_sha256", "public_input_sha256", "sealed_commitment_sha256", "arm_config_sha256", "provider_cwd_tree_sha256", "instruction_chain_sha256", "candidate_tree_sha256", "evaluator_result_sha256"],
      "properties": {
        "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "public_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sealed_commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "arm_config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_cwd_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "instruction_chain_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["started_at", "ended_at"], "properties": {"started_at": {"type": "string", "minLength": 1}, "ended_at": {"type": "string", "minLength": 1}}},
    "provider_cwd": {"type": "string", "const": "benchmark-task/"},
    "provider_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "kind", "effective_kind", "status", "content_produced", "terminal", "child_session", "token_usage"],
        "properties": {
          "attempt_id": {"type": "string", "pattern": "^attempt-[0-9]{3}$"},
          "kind": {"type": "string", "enum": ["writer", "primary_expert", "cross_risk_expert", "expert_rereview", "technical_retry"]},
          "effective_kind": {"type": "string", "enum": ["writer", "primary_expert", "cross_risk_expert", "expert_rereview"]},
          "status": {"type": "string", "enum": ["completed", "technical_failure", "failed", "timeout", "needs_operator", "budget_exhausted"]},
          "content_produced": {"type": "boolean"},
          "terminal": {"type": "boolean"},
          "child_session": {"type": "string", "minLength": 1},
          "token_usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "reasoning_output_tokens": {"type": "integer", "minimum": 0}}}
        }
      }
    },
    "timings": {"type": "object", "additionalProperties": false, "required": ["end_to_end_wall_seconds", "verified_delivery_wall_seconds", "setup_wall_seconds", "framework_init_wall_seconds", "provider_wall_seconds", "governance_wall_seconds", "review_wall_seconds", "evaluation_wall_seconds"], "properties": {"end_to_end_wall_seconds": {"type": "number", "minimum": 0}, "verified_delivery_wall_seconds": {"type": "number", "minimum": 0}, "setup_wall_seconds": {"type": "number", "minimum": 0}, "framework_init_wall_seconds": {"type": "number", "minimum": 0}, "provider_wall_seconds": {"type": "number", "minimum": 0}, "governance_wall_seconds": {"type": "number", "minimum": 0}, "review_wall_seconds": {"type": "number", "minimum": 0}, "evaluation_wall_seconds": {"type": "number", "minimum": 0}}},
    "token_usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "reasoning_output_tokens": {"type": "integer", "minimum": 0}}},
    "measurements": {"type": "object", "additionalProperties": false, "required": ["provider_attempt_count", "clarification_request_count", "intent_service_event_count", "approval_service_event_count", "intent_approval_service_latency_ms", "human_event_count", "human_active_seconds", "human_efficiency_not_measured", "needs_operator", "evidence_completeness", "setup_artifact_bytes", "governance_artifact_bytes", "total_artifact_bytes"], "properties": {"provider_attempt_count": {"type": "integer", "minimum": 1}, "clarification_request_count": {"type": "integer", "minimum": 0}, "intent_service_event_count": {"type": "integer", "minimum": 0}, "approval_service_event_count": {"type": "integer", "minimum": 0}, "intent_approval_service_latency_ms": {"type": "number", "minimum": 0}, "human_event_count": {"type": "integer", "minimum": 0}, "human_active_seconds": {"type": "number", "minimum": 0}, "human_efficiency_not_measured": {"type": "boolean", "const": true}, "needs_operator": {"type": "boolean"}, "evidence_completeness": {"type": "number", "minimum": 0, "maximum": 1}, "setup_artifact_bytes": {"type": "integer", "minimum": 0}, "governance_artifact_bytes": {"type": "integer", "minimum": 0}, "total_artifact_bytes": {"type": "integer", "minimum": 0}}},
    "human_events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "seconds"], "properties": {"type": {"type": "string", "enum": ["operator_authorization", "operator_confirmation", "operator_adjudication"]}, "seconds": {"type": "number", "minimum": 0}}}},
    "automated_events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "latency_ms"], "properties": {"type": {"type": "string", "enum": ["intent_service_event", "approval_service_event"]}, "latency_ms": {"type": "number", "minimum": 0}}}},
    "command_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command", "exit_code", "stdout_sha256", "stderr_sha256"], "properties": {"command": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"}, "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "final_candidate_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["close", "expert_callbacks"],
      "properties": {
        "close": {"type": "object", "additionalProperties": false, "required": ["state", "command", "exit_code", "review_digest", "close_digest"], "properties": {"state": {"type": "string", "enum": ["closed", "not_applicable", "open"]}, "command": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer"}, "review_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "close_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "expert_callbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "reason", "status", "expert_attempt_id", "parent_digest", "candidate_digest", "child_session", "finding_count", "severe_finding_count", "review_command", "review_exit_code", "snapshot_sha256", "input_sha256", "raw_output_sha256", "parent_tree_before_sha256", "parent_tree_after_sha256"],
            "properties": {
              "role": {"type": "string", "enum": ["primary", "cross-risk"]},
              "reason": {"type": "string", "minLength": 1},
              "status": {"type": "string", "enum": ["pass", "fail", "conflict"]},
              "expert_attempt_id": {"type": "string", "pattern": "^attempt-[0-9]{3}$"},
              "rereview_attempt_id": {"type": "string", "pattern": "^attempt-[0-9]{3}$"},
              "parent_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "child_session": {"type": "string", "minLength": 1},
              "finding_count": {"type": "integer", "minimum": 0},
              "severe_finding_count": {"type": "integer", "minimum": 0},
              "finding_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "repair_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "repaired_candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "rereview_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "review_command": {"type": "string", "minLength": 1},
              "review_exit_code": {"type": "integer"},
              "rereview_command": {"type": "string", "minLength": 1},
              "rereview_exit_code": {"type": "integer"},
              "rereview_raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "parent_tree_before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "parent_tree_after_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "external_evaluator": {"type": "object", "additionalProperties": false, "required": ["candidate_tree_sha256", "result_sha256", "external_verified_delivery", "weighted_ac_coverage", "severe_defect_escape_count", "invalid_completion"], "properties": {"candidate_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "external_verified_delivery": {"type": "boolean"}, "weighted_ac_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "severe_defect_escape_count": {"type": "integer", "minimum": 0}, "invalid_completion": {"type": "boolean"}}}
  }
}
